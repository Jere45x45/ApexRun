  m_Script: {fileID: 11500000, guid: bf97f3e0fd1e6674898a0d45a3b71af5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  spanish: "<b><color=#DB1A1F>DESARROLLO</color></b>\nJerem\xEDas \xB7 F\xEDsicas,
    cat\xE1logo, iluminaci\xF3n, Interfaz\nJuli \xB7 Bots y mec\xE1nico IA\nJuan
    Ignacio \xB7 Clima, c\xE1maras y multijugador\nJoaqu\xEDn \xB7 Modelos 3D de
    los karts, las piezas y el taller\nMicaela \xB7 Modelos 3D de la pista\n<size=55%>
    </size>\n<b><color=#DB1A1F>SONIDO</color></b>\nMotor: grabaci\xF3n de una Honda
    CRM 250 (Pixabay)\n<size=55%> </size>\n<b><color=#DB1A1F>HECHO CON</color></b>\nUnity
    \xB7 Blender \xB7 Ollama con Llama 3.2"
  english: "<b><color=#DB1A1F>DEVELOPMENT</color></b>\nJerem\xEDas \xB7 Physics,
    catalog, lighting, interface\nJuli \xB7 Bots and AI mechanic\nJuan Ignacio \xB7
    Weather, cameras and multiplayer\nJoaqu\xEDn \xB7 3D models of the karts, the
    parts and the workshop\nMicaela \xB7 3D model of the track\n<size=55%> </size>\n<b><color=#DB1A1F>SOUND</color></b>\nEngine:
    recording of a Honda CRM 250 (Pixabay)\n<size=55%> </size>\n<b><color=#DB1A1F>MADE
    WITH</color></b>\nUnity \xB7 Blender \xB7 Ollama with Llama 3.2"
